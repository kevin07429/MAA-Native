<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Settings.VersionUpdateSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Settings"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type settings_vms:VersionUpdateSettingsUserControlModel}}"
    d:DesignWidth="540"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <StackPanel Margin="8">
        <controls:GlobalConfigTip />
        <controls:TextBlock Margin="5" Text="{DynamicResource Settings.Update.NativeProgramSource}" />
        <Button
            Margin="5"
            HorizontalAlignment="Left"
            Command="{s:Action ManualUpdate}"
            Content="{DynamicResource Settings.Update.NativeProgram}"
            IsEnabled="{c:Binding !IsCheckingForUpdates}" />
        <controls:TextBlock
            Margin="5"
            Text="{Binding NewVersionFoundInfo}"
            TextWrapping="Wrap" />
        <CheckBox
            Margin="5"
            Content="{DynamicResource Settings.Update.NativeStartup}"
            IsChecked="{Binding StartupUpdateCheck}" />
        <CheckBox
            Margin="5"
            Content="{DynamicResource Settings.Update.NativeSchedule}"
            IsChecked="{Binding UpdateAutoCheck}" />
        <controls:TextBlock Margin="5" Text="{DynamicResource Settings.Update.Source}" />
        <hc:ComboBox
            Width="190"
            Margin="5"
            HorizontalAlignment="Left"
            DisplayMemberPath="Display"
            ItemsSource="{Binding UpdateSourceList}"
            SelectedValue="{Binding UpdateSource}"
            SelectedValuePath="Value" />
        <controls:UpdateCredentialInput
            Width="250"
            Margin="5"
            HorizontalAlignment="Left" />
        <controls:TextBlock Margin="5" Text="{DynamicResource Settings.Update.Proxy}" />
        <StackPanel Margin="5" Orientation="Horizontal">
            <hc:ComboBox
                Width="120"
                DisplayMemberPath="Display"
                ItemsSource="{Binding ProxyTypeList}"
                SelectedValue="{Binding ProxyType}"
                SelectedValuePath="Value" />
            <hc:TextBox
                Width="180"
                Margin="8,0,0,0"
                hc:InfoElement.Placeholder="&lt;IP&gt;:&lt;Port&gt;"
                Text="{Binding Proxy}" />
        </StackPanel>
        <controls:TextBlock Margin="5" Text="{Binding ResourceDateTimeCurrentCultureString}" />
        <Button
            Margin="5"
            HorizontalAlignment="Left"
            Command="{s:Action ManualUpdateResource}"
            Content="{DynamicResource Settings.Update.ResourceUpdate}"
            IsEnabled="{c:Binding !IsCheckingForUpdates}" />
        <controls:TextBlock
            Margin="5"
            Text="{Binding Path=DownloadLogItemViewModel.Content, Source={x:Static helper:Instances.TaskQueueViewModel}}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
